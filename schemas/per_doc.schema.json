{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pretrain-data-eval.local/schemas/per_doc.schema.json",
  "title": "Per-document evaluation result",
  "type": "object",
  "required": ["schema_version", "artifact_type", "doc_id", "scores", "flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "per_doc"},
    "doc_id": {"type": "string", "minLength": 1},
    "scores": {"type": "object"},
    "flags": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "additionalProperties": false
}
